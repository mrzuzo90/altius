# ---------------------------------------------------------------------------
# Altius — configuración
#
# Ninguna clave es obligatoria para arrancar en local salvo SEC_USER_AGENT,
# que la propia SEC exige. Sin las demás, la aplicación degrada con elegancia.
# ---------------------------------------------------------------------------

# OBLIGATORIA. La SEC devuelve 403 a cualquier petición sin User-Agent
# identificable. Pon tu nombre y un email real de contacto.
# Referencia: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="Altius/1.0 (tu-nombre; tu-email@ejemplo.com)"

# OPCIONAL. Activa el copiloto de resúmenes del MD&A y la traducción del
# apartado de negocio a lenguaje coloquial. La división que más beneficio
# aporta se calcula aparte desde Inline XBRL y no depende del modelo.
# Clave gratuita en https://aistudio.google.com/apikey
# Sin ella, el resumen se genera de forma extractiva y se marca como tal.
GEMINI_API_KEY=

# OPCIONAL. Modelo a usar. Por defecto gemini-flash-latest, con salto
# automático a gemini-flash-lite-latest si el primero falla.
# Ojo: en el nivel gratuito los modelos "pro" devuelven 429 con cuota cero, y
# los gemini-2.5-* responden 404 a las cuentas nuevas.
GEMINI_MODEL=

# OPCIONAL. Activa el gráfico de cotización.
# Clave gratuita en https://www.alphavantage.co/support/#api-key
# Límite del plan gratuito: 25 peticiones al día. Altius cachea 6 horas por
# ticker, así que da para unos 25 valores distintos diarios.
# Se usa la serie SEMANAL: en el plan gratuito el histórico completo del
# endpoint diario es de pago y queda limitado a unas 100 sesiones.
ALPHAVANTAGE_API_KEY=

# OPCIONAL. Activa el módulo de presión de opciones para acciones de EE. UU.
# Tradier es la vía preferida: una cuenta de brokerage da mercado consolidado
# en tiempo real; su sandbox entrega datos retrasados. No se envía la clave al
# navegador. Documentación: https://docs.tradier.com/docs/market-data
TRADIER_API_TOKEN=
# Usa "sandbox" solo con un token de paper trading. Por defecto: producción.
TRADIER_ENV=

# OPCIONAL. Alternativa accesible desde Europa. El plan Free Forever ofrece
# 100 créditos diarios y cadenas con 24 h de retraso. Altius limita la descarga
# a dos vencimientos y 14 strikes por vencimiento para cuidar la cuota.
# AAPL se puede probar sin clave como símbolo demo.
# https://www.marketdata.app/docs/account/free-accounts/
MARKETDATA_API_TOKEN=

# OPCIONAL. Sin clave se usa el CSV público de fredgraph, que funciona igual.
# Con clave se usa el API JSON oficial. https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=

# OPCIONAL. Si ambas existen, activa Supabase como caché compartida y conserva
# el disco como respaldo oportunista. Aplica antes la migración de supabase/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
